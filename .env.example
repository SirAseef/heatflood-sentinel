# Copy to .env (git-ignored). Never commit real secrets.
HFS_PROFILE=dev-lite
# ERA5 via Copernicus CDS (optional; Open-Meteo archive is used when unset)
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=
# PMD station files (adapter disabled until set)
PMD_DATA_PATH=
# Streaming
KAFKA_BOOTSTRAP=kafka:9092
SPARK_MASTER_URL=spark://spark-master:7077
HFS_MAX_OFFSETS=50000
# Storage (parquet default; set HFS_STORAGE=delta with deltalake installed; S3/MinIO via HFS_STORAGE_ROOT)
HFS_STORAGE=parquet
HFS_STORAGE_ROOT=
# API auth - change before any shared deployment
JWT_SECRET=change-me
ADMIN_BOOTSTRAP_PASSWORD=change-me
ANALYST_PASSWORD=change-me
VIEWER_PASSWORD=change-me
